---
import { SITE_LOCALE, localizedPath, stripLocalePrefix } from "@utils/site-locale";
import { coreLocales, blogLocales, localizedReadingRoutes } from "@utils/blog-locales.mjs";

const currentPath = stripLocalePrefix(Astro.url.pathname);
const isAdmin = /^\/admin(?:\/|$)/.test(currentPath);
const isDiary = process.env.SITE_VARIANT === "sayori-diary";
const locales = isDiary ? coreLocales : blogLocales;
const { article = false } = Astro.props as { article?: boolean };
---

{
	!isAdmin && (
		<select
			class="transition link text-[var(--primary)] font-medium bg-transparent border-0 cursor-pointer"
			data-language-switch
			data-article-switch={article ? "true" : undefined}
			aria-label="Language"
		>
			{locales.map(({ id, name, hreflang }, index) => (
				<option value={localizedPath(index < coreLocales.length || localizedReadingRoutes.includes(currentPath) || currentPath.startsWith("/posts/") ? currentPath : "/", id)} data-locale={id} data-hreflang={hreflang} lang={id} selected={id === SITE_LOCALE}>
					{name}
				</option>
			))}
		</select>
	)
}

<script>
	import { navigate } from "astro:transitions/client";
	function setupLanguageSwitch() {
	const scope = window as typeof window & { __sayoriLanguageBound?: boolean };
	if (scope.__sayoriLanguageBound) return;
	scope.__sayoriLanguageBound = true;
		document.addEventListener("change", (event) => {
			const select = event.target;
			if (!(select instanceof HTMLSelectElement) || !select.matches("[data-language-switch]")) return;
			const option = select.selectedOptions[0];
			const locale = option?.dataset.locale || "en";
			if (["zh-CN", "zh-Hant", "en"].includes(locale)) {
				try {
					localStorage.setItem("sayori-locale", locale);
					localStorage.setItem("sayori:ui-language", locale);
				} catch { /* Navigation still works without storage. */ }
				document.cookie = `sayori_locale=${encodeURIComponent(locale)}; Domain=.sayori.org; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
				document.cookie = "sayori_locale_auto=; Domain=.sayori.org; Path=/; Max-Age=0; SameSite=Lax; Secure";
			}
			void navigate(`${select.value}${window.location.search}${window.location.hash}`);
		});
	}
	setupLanguageSwitch();
</script>
