---
/**
 * ButtonLink - 分类列表按钮组件
 *
 * 用于分类、归档等列表项的链接按钮，支持徽章显示。
 *
 * @deprecated 这是一个特定用途的组件，保留在 control/ 目录中。
 *             新的通用按钮需求请使用 atoms/Button。
 */
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---

<a
	href={url}
	aria-label={label}
	class:list={`
            flex items-center
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            pl-2
            hover:pl-3

            text-neutral-700
            hover:text-[var(--primary)]
            dark:text-neutral-300
            dark:hover:text-[var(--primary)]
        `}
>
		<span class="flex w-full items-center justify-between relative mr-2">
			<span
				class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis"
			>
				<slot />
			</span>
			{
				badge !== undefined && badge !== null && badge !== "" && (
					<span
						class="transition px-2 h-7 ml-4 min-w-[2rem] rounded-lg text-sm font-bold
                    text-black
                    bg-[var(--btn-regular-bg)] dark:bg-[var(--primary)]
                    flex items-center justify-center"
					>
						{badge}
					</span>
				)
			}
		</span>
</a>
