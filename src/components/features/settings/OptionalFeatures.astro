---
import { isEnglishSite } from "../../../utils/site-locale";
---
<div id="desk-features" transition:persist="desk-features" data-pagefind-ignore>
<div id="desk-pet-host" data-pagefind-ignore></div>
<div id="desk-music-host" data-pagefind-ignore></div>
<button data-pagefind-ignore id="desk-music-entry" class="desk-music-entry" type="button" hidden>{isEnglishSite ? "♫ Music" : "♫ 音乐"}</button>
<p id="desk-feature-status" class="desk-feature-status" role="status" hidden></p>
</div>
<script>
	import type { Component } from "svelte";
	import { openMusicPlayer, closeMusicPlayer } from "../../../scripts/music-entry";
	function setupOptionalFeatures() {
	const host = document.querySelector<HTMLElement>("#desk-features")!;
	if (host.dataset.bound) return;
	host.dataset.bound = "true";
	const petKey = "sayori-desk-pet-enabled";
	const musicKey = "sayori-desk-music-enabled";
	const entry = document.querySelector<HTMLButtonElement>("#desk-music-entry")!;
	const status = document.querySelector<HTMLElement>("#desk-feature-status")!;
	let petEnabled = false;
	let musicEnabled = false;
	let pet: ReturnType<typeof import("svelte").mount> | undefined;
	let petLoading = false;
	function report(error: unknown) {
		console.error("Optional feature failed", error);
		status.hidden = false;
		status.textContent = document.documentElement.lang === "en" ? "Could not load. Try again from Settings." : document.documentElement.lang === "zh-Hant" ? "載入失敗，可在設定頁重新開啟。" : "加载失败，可在设置页重新开启。";
	}
	function read(key: string) {
		try { return localStorage.getItem(key) === "true"; }
		catch (error) { console.warn("Preferences unavailable", error); return false; }
	}
	async function updatePet() {
		if (!petEnabled) {
			if (pet) {
				const previous = pet; pet = undefined;
				await (await import("svelte")).unmount(previous);
			}
			return;
		}
		if (pet || petLoading) return;
		petLoading = true;
		try {
			const styles = new Set(document.head.querySelectorAll("link[rel=stylesheet], style"));
			const [{ mount }, { default: Pet }] = await Promise.all([import("svelte"), import("../sayori-pet/SayoriPet.svelte")]);
			for (const style of document.head.querySelectorAll("link[rel=stylesheet], style")) {
				if (!styles.has(style)) host.append(style);
			}
			if (petEnabled && !pet) pet = mount(Pet as unknown as Component, { target: document.querySelector("#desk-pet-host")! });
		} catch (error) { report(error); }
		finally { petLoading = false; }
	}
	function syncInputs() {
		const petInput = document.querySelector<HTMLInputElement>("[data-pet-preference]");
		const musicInput = document.querySelector<HTMLInputElement>("[data-music-preference]");
		if (petInput) petInput.checked = petEnabled;
		if (musicInput) musicInput.checked = musicEnabled;
		entry.hidden = !musicEnabled;
		entry.textContent = document.documentElement.lang === "en" ? "♫ Music" : document.documentElement.lang === "zh-Hant" ? "♫ 音樂" : "♫ 音乐";
	}
	function restore() {
		petEnabled = read(petKey); musicEnabled = read(musicKey);
		syncInputs();
		void updatePet();
		if (!musicEnabled) void closeMusicPlayer();
	}
	document.addEventListener("change", event => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement)) return;
		const isPet = input.matches("[data-pet-preference]");
		if (!isPet && !input.matches("[data-music-preference]")) return;
		status.hidden = true;
		if (isPet) petEnabled = input.checked;
		else musicEnabled = input.checked;
		try { localStorage.setItem(isPet ? petKey : musicKey, String(input.checked)); } catch (error) { report(error); }
		syncInputs();
		if (isPet) void updatePet();
		else if (!musicEnabled) closeMusicPlayer();
	});
	entry.addEventListener("click", async () => {
		entry.disabled = true; status.hidden = true;
		try { await openMusicPlayer(); } catch (error) { report(error); }
		finally { entry.disabled = false; }
	});
	// Astro's module runs after the document is parsed; no optional code is imported before opt-in.
	petEnabled = read(petKey); musicEnabled = read(musicKey); syncInputs();
	if (document.readyState === "complete") void updatePet();
	else window.addEventListener("load", () => void updatePet(), { once: true });
	window.addEventListener("pageshow", event => { if (event.persisted) restore(); });
	window.addEventListener("storage", event => { if (event.key === petKey || event.key === musicKey) restore(); });
	window.addEventListener("pagehide", () => void closeMusicPlayer());
	document.addEventListener("astro:page-load", syncInputs);
	}
	setupOptionalFeatures();
</script>
