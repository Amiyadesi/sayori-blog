---
import { commentConfig } from "@/config";
import { isEnglishSite, isTraditionalSite } from "../../utils/site-locale";

interface Props {
	path: string;
	reviewOnly?: boolean;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
const reviewOnly = Astro.props.reviewOnly === true;
const ownerNick = "Amiya_desi";
const ownerAvatar = "/assets/profile/avatar-sayori-192.jpg";
---

<div
	id="twikoo-container"
	class:list={["twikoo-container", reviewOnly && "is-review-only"]}
	data-twikoo-options={JSON.stringify({ config, ownerNick, ownerAvatar, reviewOnly, isEnglishSite })}
>
	<div id="tcomment"><button type="button" data-comment-load>{isEnglishSite ? "Load comments" : isTraditionalSite ? "載入評論" : "加载评论"}</button></div>
	{
		reviewOnly && (
			<p class="twikoo-review-hint">
				{isEnglishSite
					? "This is the friend-link submission area. Submissions enter the site owner's review queue and are not published immediately."
					: "这里是友链申请投递区。提交后只会进入站长审核队列，不会直接公开展示。"}
			</p>
		)
	}
</div>


<script>
	import "../../scripts/twikoo-loader";
</script>
<style>
	.twikoo-container { min-height: 200px; }
	:global(#tcomment > button), :global(.twikoo-module-status) { min-height: 44px; padding: .75rem 1rem; color: var(--primary); }
</style>
