---
import type { SiteLocale } from "@utils/site-locale";
const { locale } = Astro.props as { locale: SiteLocale };
const labels = locale === "en" ? {
	search: "Search", title: "Search the notebook", close: "Close", placeholder: "Title or keyword…",
	busy: "Searching…", retry: "Search unavailable. Retry", empty: "No matching posts.",
} : locale === "zh-Hant" ? {
	search: "搜尋", title: "在書桌上找一找", close: "關閉", placeholder: "標題或關鍵詞…",
	busy: "正在查找…", retry: "搜尋載入失敗，點此重試", empty: "沒有找到相關文章。",
} : {
	search: "搜索", title: "在书桌上找一找", close: "关闭", placeholder: "标题或关键词…",
	busy: "正在查找…", retry: "搜索加载失败，点击重试", empty: "没有找到相关文章。",
};
---
<button type="button" class="desk-search-button" data-search-open aria-label={labels.search} aria-haspopup="dialog" aria-controls="desk-search">
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
	<span>{labels.search}</span>
</button>
<dialog id="desk-search" class="desk-search" aria-label={labels.search} data-locale={locale} data-labels={JSON.stringify(labels)}>
	<form>
		<label for="desk-search-input">{labels.title}</label>
		<button type="button" class="search-close" data-search-close aria-label={labels.close}>×</button>
		<input id="desk-search-input" placeholder={labels.placeholder} type="search" autocomplete="off" />
	</form>
	<div aria-live="polite" class="search-status"></div>
	<ul></ul>
</dialog>
<script>
	import "../../../scripts/desk-search";
</script>
