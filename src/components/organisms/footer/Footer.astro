---
import * as fs from "node:fs";
import * as path from "node:path";

import { footerConfig, profileConfig } from "../../../config";
import LanguageSwitch from "../../control/LanguageSwitch.astro";
import { getLocalizedTopic, getTopicUrl, topics } from "../../../data/topics";
import { url } from "../../../utils/url-utils";
import { isEnglishSite } from "../../../utils/site-locale";

const currentYear = new Date().getFullYear();
const webmasterTopicSource = topics.find((topic) => topic.slug === "webmaster");
const webmasterTopic = webmasterTopicSource
	? getLocalizedTopic(webmasterTopicSource, isEnglishSite)
	: undefined;
const registrationLinks = [
	{
		label: isEnglishSite ? "Moe ICP filing" : "萌ICP备20260605号",
		href: "https://icp.gov.moe/?keyword=20260605",
	},
	{
		label: isEnglishSite ? "Tea ICP filing" : "茶ICP备2026070378号",
		href: "https://icp.redcha.cn/beian/ICP-2026070378.html",
	},
];
const blogNetworkLinks = [
	{
		label: isEnglishSite ? "Travellings" : "开往 Travellings",
		href: "https://www.travellings.cn/go.html",
	},
	{
		label: isEnglishSite ? "Moe ICP" : "萌备",
		href: "https://icp.gov.moe/",
	},
	{
		label: isEnglishSite ? "Forever Blog" : "十年之约",
		href: "https://www.foreverblog.cn/",
	},
	{
		label: isEnglishSite ? "JiuChan" : "揪蝉",
		href: "https://hi.jiuchan.org/docs",
	},
	{
		label: isEnglishSite ? "Chinese Independent Blogs" : "中文独立博客列表",
		href: "https://github.com/timqian/chinese-independent-blogs",
	},
	{
		label: "BlogFinder",
		href: "https://bf.zzxworld.com/",
	},
	{
		label: isEnglishSite ? "Blog Friends Circle" : "博友圈",
		href: "https://www.boyouquan.com/",
	},
	{
		label: isEnglishSite ? "Firewood" : "积薪",
		href: "https://firewood.news/",
	},
	{
		label: isEnglishSite ? "BlogsClub Shuttle" : "BlogsClub 空间穿梭",
		href: "https://www.blogsclub.org/shuttle.html",
	},
	{
		label: isEnglishSite ? "Blogscn sponsorship" : "笔墨迹招商",
		href: "https://blogscn.fun/pages/zhaoshang",
	},
	{
		label: isEnglishSite ? "Blog Alliance" : "博客大联盟",
		href: "https://bo.ke/",
	},
];

// 页脚自定义内容逻辑
let customFooterHtml = "";
if (footerConfig.enable) {
	// 优先使用 customHtml，如果为空则使用 FooterConfig.html 文件内容
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		// customHtml 为空时，读取 FooterConfig.html 文件内容
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			// 移除HTML注释
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn(
				"FooterConfig.html文件读取失败:",
				error instanceof Error ? error.message : error,
			);
		}
	}
}
---

<!--<div class="border-t border-[var(--primary)] mx-16 border-dashed py-8 max-w-[var(--page-width)] flex flex-col items-center justify-center px-6">-->
<div
	class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"
>
</div>
<div
	class="transition border-dashed border-[var(--line-color)] rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
	<div class="transition text-50 text-sm text-center">
		{isEnglishSite ? (
			<div class="mb-2 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
				{registrationLinks.map((item, index) => (
					<>
						{index > 0 && <span aria-hidden="true">/</span>}
						<a
							class="transition link text-[var(--primary)] font-medium"
							href={item.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							{item.label}
						</a>
					</>
				))}
			</div>
		) : (
			customFooterHtml && <div class="mb-2" set:html={customFooterHtml} />
		)}

		<div
			class="mb-3 flex flex-wrap items-center justify-center gap-x-2 gap-y-1"
			aria-label={isEnglishSite ? "Blog networks and directories" : "博客圈与目录"}
		>
			<span class="font-medium text-[var(--text-70)]">
				{isEnglishSite ? "Blog networks & directories" : "博客圈与目录"}
			</span>
			{blogNetworkLinks.map((item) => (
				<>
					<span aria-hidden="true">/</span>
					<a
						class="transition link text-[var(--primary)] font-medium"
						href={item.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{item.label}
					</a>
				</>
			))}
		</div>

		<div class="mb-2">
			&copy; <span id="copyright-year">{currentYear}</span>
			{profileConfig.name}. All Rights Reserved. /
			<a
				class="transition link text-[var(--primary)] font-medium"
				href={url("rss/")}
				onclick={`event.preventDefault(); navigateToPage('${url("rss/")}')`}
				>RSS</a
			> /
			<a
				class="transition link text-[var(--primary)] font-medium"
				href={url("atom/")}
				onclick={`event.preventDefault(); navigateToPage('${url("atom/")}')`}
				>Atom</a
			> /
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href={url("sitemap-index.xml")}>Sitemap</a
			>
			 / <LanguageSwitch />
			{
				webmasterTopic && (
					<>
						{" "}
						/
						<a
							class="transition link text-[var(--primary)] font-medium"
							href={url(getTopicUrl(webmasterTopic))}
							onclick={`event.preventDefault(); navigateToPage('${url(getTopicUrl(webmasterTopic))}')`}
						>
							Topics
						</a>
					</>
				)
			}
		</div>

		<div>
			Powered by
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://astro.build">Astro</a
			> &
			<a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://github.com/LyraVoid/Mizuki">Mizuki</a
			>&nbsp; Version <a
				class="transition link text-[var(--primary)] font-medium"
				target="_blank"
				href="https://github.com/LyraVoid/Mizuki">9.0</a
			>
		</div>
	</div>
</div>
