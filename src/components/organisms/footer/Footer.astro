---
import { profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";
import { isEnglishSite } from "../../../utils/site-locale";
const currentYear = new Date().getFullYear();
const registrationLinks = [
	{
		label: isEnglishSite ? "Moe ICP filing" : "萌ICP备20260605号",
		href: "https://icp.gov.moe/?keyword=20260605",
	},
	{
		label: isEnglishSite ? "Tea ICP filing" : "茶ICP备2026070378号",
		href: "https://icp.redcha.cn/beian/ICP-2026070378.html",
	},
];
const blogNetworkLinks = [
	{
		label: isEnglishSite ? "Travellings" : "开往 Travellings",
		href: "https://www.travellings.cn/go.html",
	},
	{
		label: isEnglishSite ? "Moe ICP" : "萌备",
		href: "https://icp.gov.moe/",
	},
	{
		label: isEnglishSite ? "Forever Blog" : "十年之约",
		href: "https://www.foreverblog.cn/",
	},
	{
		label: isEnglishSite ? "JiuChan" : "揪蝉",
		href: "https://hi.jiuchan.org/docs",
	},
	{
		label: isEnglishSite ? "Chinese Independent Blogs" : "中文独立博客列表",
		href: "https://github.com/timqian/chinese-independent-blogs",
	},
	{
		label: "BlogFinder",
		href: "https://bf.zzxworld.com/",
	},
	{
		label: isEnglishSite ? "Blog Friends Circle" : "博友圈",
		href: "https://www.boyouquan.com/",
	},
	{
		label: isEnglishSite ? "Firewood" : "积薪",
		href: "https://firewood.news/",
	},
	{
		label: "BlogsClub",
		href: "https://www.blogsclub.org/",
	},
	{
		label: "Blogscn",
		href: "https://blogscn.fun/",
	},
	{
		label: isEnglishSite ? "Blog Alliance" : "博客大联盟",
		href: "https://bo.ke/",
	},
];

---
<footer class="desk-footer" data-pagefind-ignore>
	<div class="desk-footer-row">
		<span>© {currentYear} {profileConfig.name}</span>
		<nav class="desk-footer-links" aria-label={isEnglishSite ? "Footer" : "页脚"}>
			<a href={url("/rss/")}>RSS</a>
			<a href={url("/atom/")}>Atom</a>
			<a href={url("/about/")}>{isEnglishSite ? "About" : "关于"}</a>
			<a href={url("/privacy/")}>{isEnglishSite ? "Privacy" : "隐私说明"}</a>
			<a href={url("/settings/")}>{isEnglishSite ? "Settings" : "设置"}</a>
		</nav>
	</div>
	<div class="desk-footer-links">
		{registrationLinks.map(item => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>)}
		<span>Made with <a href="https://astro.build">Astro</a> · <a href="https://github.com/LyraVoid/Mizuki">Mizuki</a></span>
	</div>
	<details>
		<summary>{isEnglishSite ? "Blog networks & directories" : "博客圈与目录"}</summary>
		<div class="desk-footer-links">{blogNetworkLinks.map(item => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>)}</div>
	</details>
</footer>
