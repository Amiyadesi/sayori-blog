---
import Pagination from "@components/control/Pagination.astro";
import DeskIntro from "@components/features/posts/DeskIntro.astro";
import PostPage from "@components/features/posts/PostPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import SayoriDiaryLayout from "@layouts/SayoriDiaryLayout.astro";
import SayoriDiaryHome from "@components/sayori/SayoriDiaryHome.astro";
import type { GetStaticPaths } from "astro";

import { siteConfig } from "../config";
import { PAGE_SIZE } from "../constants/constants";
import {
	dedupePostsByUrl,
	getSortedPosts,
	isHomeListPost,
	isSayoriDiaryPost,
} from "../utils/content-utils";
import { initPostIdMap } from "../utils/permalink-utils";
import { getPostPublicDescription } from "../utils/post-card-content";
import { getPostUrl, url } from "../utils/url-utils";
import { currentLocalePath, isEnglishSite } from "../utils/site-locale";

const isSayoriDiarySite = process.env.SITE_VARIANT === "sayori-diary";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// 初始化文章 ID 映射（用于 permalink 功能）
	initPostIdMap(allBlogPosts);
	// Keep pagination boundaries stable even if content sync briefly exposes
	// duplicate entries with the same public URL.
	const homePosts = dedupePostsByUrl(
		allBlogPosts.filter((post) =>
			process.env.SITE_VARIANT === "sayori-diary"
				? isSayoriDiaryPost(post)
				: isHomeListPost(post),
		),
	);
	return paginate(homePosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const isHomeFirstPage = page.currentPage === 1;
const homeCopy = {
	description: isEnglishSite
		? "Amiya’s notes on game development, websites, tools, and things learned along the way."
		: "Amiya的书桌，记录游戏开发、网站、工具与学习途中的小事。",
};
const diaryCopy = isEnglishSite
	? {
			scopeHeading: "About this diary",
			scope: "This is Sayori's public diary. It contains only notes she chooses to publish; private notes and private conversations never appear here.",
			description: "Sayori's public diary, letters, and everyday notes.",
		}
	: {
			scopeHeading: "关于这本日记",
			scope: "这里是 Sayori 自己选择公开的日记。私人笔记和私聊内容不会出现在这里。",
			description: "Sayori 的公开日记、小信和日常记录。",
		};
const activeCopy = isSayoriDiarySite ? diaryCopy : homeCopy;
const pageDescription = isHomeFirstPage
	? activeCopy.description
	: `${siteConfig.title} - ${siteConfig.subtitle}`;
const pageTitle = isHomeFirstPage
	? undefined
	: isEnglishSite
		? `Page ${page.currentPage}`
		: `第 ${page.currentPage} 页`;
const pageUrl = new URL(currentLocalePath(Astro.url.pathname), siteConfig.siteURL).toString();
const siteLanguage = siteConfig.lang.replace("_", "-");
const siteUrl = new URL(siteConfig.siteURL).href;
const personId = `${siteUrl}#person`;
const organizationId = `${siteUrl}#organization`;
const jsonLd: Array<Record<string, unknown>> = [
	{
		"@context": "https://schema.org",
		"@type": "Blog",
		"@id": `${siteUrl}#blog`,
		name: siteConfig.title,
		url: siteUrl,
		description: pageDescription,
		inLanguage: siteLanguage,
		image: new URL("/assets/desktop-banner/1.webp", siteConfig.siteURL)
			.href,
		author: {
			"@id": personId,
		},
		publisher: {
			"@id": organizationId,
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		"@id": `${pageUrl}#post-list`,
		name: `${siteConfig.title} latest posts`,
		url: pageUrl,
		itemListElement: page.data.map((entry, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: new URL(getPostUrl(entry), siteConfig.siteURL).href,
			name: entry.data.title,
			description: getPostPublicDescription(entry.data, entry.data.title),
		})),
	},
];

---

{isSayoriDiarySite ? (
	<SayoriDiaryLayout title={pageTitle} description={pageDescription}>
		<SayoriDiaryHome page={page} />
	</SayoriDiaryLayout>
) : (
	<MainGridLayout title={pageTitle} description={pageDescription}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	{isHomeFirstPage && <DeskIntro />}
	<div class="latest-heading">
		<h2>{isEnglishSite ? "Latest posts" : "最新文章"}</h2>
		<a href={url("/archive/")}>{isEnglishSite ? "All posts →" : "全部归档 →"}</a>
	</div>
	<PostPage page={page} />
	<Pagination class="mx-auto mt-8" page={page} />
	</MainGridLayout>
)}
