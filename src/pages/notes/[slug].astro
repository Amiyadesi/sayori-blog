---
import Layout from '@layouts/Layout.astro';
import { HER_OWN_POSTS, type OwnPost } from '../../data/p34-own-posts';
interface Props { post: OwnPost; }
export function getStaticPaths() {
  return HER_OWN_POSTS.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
---
<Layout title={post.title} description={post.excerpt} noindex={true}>
  <script is:inline slot="head">
    if (new URLSearchParams(location.search).get('paper') !== '0617') location.replace('/');
  </script>
  <main id="swup-container" tabindex="-1" data-p34-own-route="true">
    <article data-p34-native-post={post.slug}>
      <p>{post.draft ? '未发布的草稿' : '她写的'}</p><h1>{post.title}</h1>
      <div class="space-native-prose"><Content /></div>
      <a href="/?paper=0617">回目录</a>
    </article>
  </main>
</Layout>
