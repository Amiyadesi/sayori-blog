---
import MainGridLayout from '../../layouts/MainGridLayout.astro';
import { herNotes, herProfile } from '../../data/p34-notes';
export function getStaticPaths() { return herNotes.map(note => ({ params: { slug: note.slug }, props: { note } })); }
const { note } = Astro.props;
---
<MainGridLayout title={note.title} noindex>
  <link slot="head" rel="stylesheet" href="/paper-blog.css?v=20261103-r13" />
  <article class="her-notes" data-pagefind-ignore="all">
    <nav><a href="/notes/?paper=0617">翻另外几笔</a><a href="/?paper=0617">回到博客</a></nav>
    <header><p>{herProfile.website ? <a href={herProfile.website} rel="author">{herProfile.name}</a> : herProfile.name}</p><h1>{note.title}</h1></header>
    {note.paragraphs.map(p => <p>{p}</p>)}
    {note.article && <p><a href={`${note.article}?paper=0617`}>她读到的那篇文章</a></p>}
    {note.archive && <div class="her-draft"><p>原来的链接没删。它还是会一口气弹到底。</p><a data-p34-archive href="https://sayori.org/?paper=0617&draft=first">沿着旧链接回去</a></div>}
  </article>
</MainGridLayout>
