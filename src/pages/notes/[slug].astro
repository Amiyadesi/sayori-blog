---
import Layout from "@layouts/Layout.astro";
import { HER_OWN_POSTS, type OwnPost } from "../../data/p34-own-posts";

interface Props { post: OwnPost; }
export function getStaticPaths() {
  return HER_OWN_POSTS.map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---

<Layout title={`${post.title} · 乱写的`} description={post.excerpt} noindex={true}>
  <script is:inline slot="head">
    if (new URLSearchParams(location.search).get("paper") !== "0617") location.replace("/");
  </script>
  <main id="swup-container" tabindex="-1" data-p34-own-route="true" data-p34-route-slug={post.slug}>
    <div class="p34-own-blog" data-p34-own-root="true" data-p34-view="article" data-pagefind-ignore="all">
      <header class="p34-own-masthead">
        <a href="/?paper=0617" class="p34-wordmark" data-p34-nav="index">34<span aria-hidden="true">.</span></a>
        <a href="https://sayori.org/?paper=0617" class="p34-own-nav-home" data-p34-home-link>回去玩 ↗</a>
      </header>
      <div class="p34-own-layout">
        <aside class="p34-own-margin" aria-label="她说"><p class="p34-voice-line">{post.voiceRemark}</p></aside>
        <div class="p34-own-stage">
          <ol class="p34-editorial-list"><li class="p34-index-item is-active">
            <article class="p34-index-article" data-p34-article-slug={post.slug}>
              <time class="p34-entry-date">{post.date}</time>
              <h1 class="p34-entry-title" tabindex="-1">{post.title}</h1>
              <div class="p34-entry-body"><div class="p34-body-inner">
                <p class="p34-article-lead">{post.lead}</p>
                <div class="p34-article-prose">{post.sections.map(section => (
                  <section class="p34-prose-section">
                    {section.heading && <h2>{section.heading}</h2>}
                    {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                  </section>
                ))}</div>
                <a class="p34-back-index" href="/?paper=0617" data-p34-nav="index">← 看别的</a>
              </div></div>
            </article>
          </li></ol>
        </div>
      </div>
    </div>
  </main>
</Layout>
