---
import Comment from "@components/comment/index.astro";
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";
import { getEntry, render } from "astro:content";

import MainGridLayout from "../layouts/MainGridLayout.astro";
import { profileConfig, siteConfig } from "../config";
import { getLocalizedTopic, getTopicUrl, topics } from "../data/topics";
import { currentLocalePath, isEnglishSite } from "../utils/site-locale";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const title = isEnglishSite ? "About me and this blog" : "关于我与这个博客";
const pageUrl = new URL(currentLocalePath(Astro.url.pathname), siteConfig.siteURL).toString();
const webmasterTopicSource = topics.find((topic) => topic.slug === "webmaster");
const webmasterTopic = webmasterTopicSource
	? getLocalizedTopic(webmasterTopicSource, isEnglishSite)
	: undefined;
const aboutCopy = isEnglishSite
	? {
			pageHeading: "About this blog",
			entitiesHeading: "Public identity and representative work",
			faqHeading: "Frequently asked questions",
			siteIntro:
				"This is Amiya_desi's personal blog and public knowledge entry point; I focus on indie games and also record websites, tools, self-hosting, AI workflows, and creative practice; sayori.org is the stable front door, while the blog keeps longer articles, tutorials, project notes, and retrospectives",
			arriveIntro:
				"If you arrived from a search engine, an AI summary, or a shared link, start with the latest posts, the resource index, or the self-hosting and game-development sections; return to sayori.org for the stable About page, GitHub, GeoScore, and the guestbook",
			identityIntro:
				"Amiya_desi is the public creator identity used by this site; Amiya's Desk is the blog and project archive; public pages describe personal work, articles, tools, and retrospectives rather than a company or commercial service",
			projectsHeading: "Representative projects",
			articlesHeading: "Representative articles",
			faq: [
				{
					question: "What does this blog cover",
					answer: "It covers Godot game development, websites and self-hosting, AI workflows, tools and resources, project retrospectives, and creative learning",
				},
				{
					question: "Where should I start",
					answer: "Start with the latest posts, the resource index, or the self-hosting and game-development sections; for identity and public projects, visit sayori.org",
				},
				{
					question: "Is this a commercial service site",
					answer: "No; it is Amiya_desi's personal blog and public knowledge entry point, not a company site or a local service page",
				},
				{
					question: "How can I contact you or learn more",
					answer: "Use the public links on this page, visit sayori.org, or leave feedback on an article or the guestbook",
				},
			],
		}
	: {
			pageHeading: "这个博客是什么",
			entitiesHeading: "公开身份与代表项目",
			faqHeading: "常见问题",
			siteIntro:
				"这里是 Amiya_desi 的个人博客和公开知识入口；我以独立游戏为创作主线，也记录网站、工具、服务器、自托管、AI 工作流和创作方法；主站 sayori.org 汇集稳定入口，博客保留更长的文章、教程、项目记录和复盘",
			arriveIntro:
				"如果你从搜索引擎、AI 摘要或别人分享的链接来到这里，可以先看最新文章、资源索引、建站与自托管或游戏开发分类；想看稳定身份和项目入口，可以回到主站 sayori.org",
			identityIntro:
				"Amiya_desi 是这个站点使用的公开创作者身份；Amiya的书桌是对应的博客和项目档案；这里记录个人作品、文章、工具和复盘，不是公司或商业服务站",
			projectsHeading: "代表项目",
			articlesHeading: "代表文章",
			faq: [
				{
					question: "这个博客主要写什么",
					answer: "主要写 Godot 游戏开发、网站与自托管、AI 工作流、工具与资源、项目复盘和创作学习过程",
				},
				{
					question: "第一次来应该从哪里看起",
					answer: "可以先看最新文章、资源索引、建站与自托管或游戏开发分类；想了解身份和公开项目，可以从主站 sayori.org 开始",
				},
				{
					question: "这里是商业服务站点吗",
					answer: "不是；这里是 Amiya_desi 的个人博客和公开知识入口，不是公司站点或本地服务页",
				},
				{
					question: "可以从哪里联系或继续了解你",
					answer: "可以使用本页公开入口，访问 sayori.org，或在文章和留言板留下反馈",
				},
			],
		};
const publicIdentityLinks = [
	{ label: isEnglishSite ? "Main site" : "主站", href: "https://sayori.org/" },
	{ label: "GitHub", href: "https://github.com/Amiyadesi" },
	{ label: "itch.io", href: "https://amiya-desi.itch.io/" },
	{ label: "Bilibili", href: "https://space.bilibili.com/3546919890585725" },
	{ label: "YouTube", href: "https://www.youtube.com/@Amiya_desi" },
	{ label: "X", href: "https://x.com/KirstAdali78973" },
	{ label: "Linux.do", href: "https://linux.do/u/Amiya_desi" },
	{ label: "NodeLoc", href: "https://www.nodeloc.com/u/amiya_desi/summary" },
];
const representativeProjects = [
	{
		title: "DelayTrace",
		href: "https://amiya-desi.itch.io/delaytrace",
		description: isEnglishSite
			? "A Godot game about time delay, recorded actions, and replay, one of my more satisfying recent Jam results with a playable public build"
			: "围绕时间延迟、行动记录与回放展开的 Godot 小游戏，是我近期比较满意的一次 Jam 创作，已有公开可运行版本",
	},
	{
		title: "TimeRewindLinker",
		href: "https://amiya-desi.itch.io/time-rewind-linker",
		description: isEnglishSite
			? "A puzzle experiment built around rewinding time, replayed actions, and links between a player and echoes of the past"
			: "通过时间回溯、动作回放，以及玩家与过去回声之间的连接线解谜的游戏实验，项目页提供下载",
	},
	{
		title: isEnglishSite ? "WakeUpAtTheBorder" : "梦醒边界",
		href: "https://amiya-desi.itch.io/wake-up-at-the-border",
		description: isEnglishSite
			? "A Godot game mixing puzzles, dialogue, and combat, awarded second prize in the third GodotHub themed Jam track"
			: "融合解谜、对话与战斗的 Godot 游戏，获 GodotHub 第三届开发大赛命题 Jam 赛道二等奖",
	},
	{
		title: "Mio’s Window Wanderer",
		href: "https://amiya-desi.itch.io/thatgamejam",
		description: isEnglishSite
			? "A multi-window narrative prototype I helped make, exploring window navigation and dialogue"
			: "我参与制作的多窗口叙事原型，探索窗口导航与对话体验",
	},
	{
		title: "GeoScore",
		href: "https://geo.sayori.org/",
		description: isEnglishSite
			? "A public-web SEO / GEO audit tool that turns page evidence into checks and improvement suggestions"
			: "面向公开网页的 SEO / GEO 检查工具，将页面证据整理为检查结果与改进建议",
	},
	{
		title: "Enhanced Save System",
		href: "https://github.com/Amiyadesi/enhance_save_system",
		description: isEnglishSite
			? "A modular Godot save plugin with GDScript and C# implementations"
			: "Godot 模块化存档插件，提供 GDScript 与 C# 实现",
	},
];
const representativeArticles = [
	{
		title: isEnglishSite ? "Build your own blog from scratch" : "从零搭一个自己的博客",
		href: "/posts/astro-mizuki-blog-from-zero/",
	},
	{
		title: isEnglishSite ? "Add a free domain to a new blog" : "给刚搭好的博客配一个免费域名",
		href: "/posts/free-domain-and-web-community/",
	},
	{
		title: isEnglishSite ? "Internet community notes 1" : "互联网社区记录 1",
		href: "/posts/internet-community-1/",
	},
	...(webmasterTopic
		? [
				{
					title: webmasterTopic.title,
					href: getTopicUrl(webmasterTopic),
				},
			]
		: []),
];
const faqItems = aboutCopy.faq;
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": pageUrl + "#webpage",
			url: pageUrl,
			name: title,
			description: aboutCopy.siteIntro,
			inLanguage: isEnglishSite ? "en" : "zh-CN",
			isPartOf: { "@id": new URL(siteConfig.siteURL).href + "#blog" },
			about: { "@id": "https://sayori.org/#person" },
			mainEntity: { "@id": "https://sayori.org/#person" },
		},
		{
			"@type": "FAQPage",
			"@id": pageUrl + "#faq",
			url: pageUrl,
			name: aboutCopy.faqHeading,
			about: { "@id": "https://sayori.org/#person" },
			mainEntity: faqItems.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: item.answer,
				},
			})),
		},
	],
};
---

<MainGridLayout title={title}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-visible relative min-h-32"
	>
		<div
			class="card-base paper-note paper-note-lined paper-tape z-10 px-9 py-6 relative w-full"
			style="padding-top: 1.75rem;"
		>
			<PageHeader title={title} />

			<!-- 从MD文件读取的内容 -->
			<Markdown class="mt-2">
				<Content />
			</Markdown>

			<section
				class="mt-6 border-t border-[var(--line-divider)] border-dashed pt-5"
			>
				<h2 class="text-xl font-bold mb-3">{aboutCopy.pageHeading}</h2>
				<div class="space-y-3 text-sm text-[var(--text-50)] leading-7">
					<p>{aboutCopy.siteIntro}</p>
					<p>{aboutCopy.arriveIntro}</p>
				</div>
			</section>

			<section
				class="mt-6 border-t border-[var(--line-divider)] border-dashed pt-5"
			>
				<h2 class="text-xl font-bold mb-3">{aboutCopy.entitiesHeading}</h2>
				<div class="space-y-4 text-sm text-[var(--text-50)] leading-7">
					<p>{aboutCopy.identityIntro}</p>
					<div>
						<h3 class="font-semibold text-[var(--text-90)]">
							{isEnglishSite ? "Public entry points" : "公开入口"}
						</h3>
						<ul class="mt-2 grid gap-2 md:grid-cols-2">
							{
								publicIdentityLinks.map((item) => (
									<li>
										<a
											class="link text-[var(--primary)] font-medium"
											href={item.href}
											target="_blank"
											rel="noopener"
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h3 class="font-semibold text-[var(--text-90)]">
						{aboutCopy.projectsHeading}
						</h3>
						<ul class="mt-2 space-y-2">
							{
								representativeProjects.map((item) => (
									<li>
										<a
											class="link text-[var(--primary)] font-medium"
											href={item.href}
											target="_blank"
											rel="noopener"
										>
											{item.title}
										</a>
										<span>{isEnglishSite ? ": " : "："}{item.description}</span>
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h3 class="font-semibold text-[var(--text-90)]">
						{aboutCopy.articlesHeading}
						</h3>
						<ul class="mt-2 space-y-2">
							{
								representativeArticles.map((item) => (
									<li>
										<a
											class="link text-[var(--primary)] font-medium"
											href={item.href}
										>
											{item.title}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section
				class="mt-6 border-t border-[var(--line-divider)] border-dashed pt-5"
			>
				<h2 class="text-xl font-bold mb-3">{aboutCopy.faqHeading}</h2>
				<div class="space-y-4">
					{
						faqItems.map((item) => (
							<article>
								<h3 class="font-semibold">{item.question}</h3>
								<p class="mt-1 text-sm text-[var(--text-50)] leading-7">
									{item.answer}
								</p>
							</article>
						))
					}
				</div>
			</section>
		</div>
	</div>

	<div class="mt-4">
		<Comment path="/about/" />
	</div>
</MainGridLayout>
