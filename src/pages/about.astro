---
import Comment from "@components/comment/index.astro";
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";
import { getEntry, render } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { profileConfig, siteConfig } from "../config";
import { currentLocalePath, isEnglishSite, SITE_LOCALE } from "../utils/site-locale";

const aboutPost = await getEntry("spec", "about");
if (!aboutPost) throw new Error("About page content not found");
const { Content } = await render(aboutPost);
const title = isEnglishSite ? "About" : "关于";
const pageUrl = new URL(currentLocalePath(Astro.url.pathname), siteConfig.siteURL).href;
const jsonLd = {
  "@context": "https://schema.org", "@type": "AboutPage",
  "@id": pageUrl + "#webpage", url: pageUrl, name: title, inLanguage: SITE_LOCALE,
  about: { "@type": "Person", name: profileConfig.name, url: "https://sayori.org/" },
};
---
<MainGridLayout title={title}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="desk-article" data-pagefind-body>
    <PageHeader title={title} />
    <p class="mb-6" data-pagefind-ignore>
      <a href={currentLocalePath("/about/stats/")}>{isEnglishSite ? "Blog statistics: articles and updates" : "博客统计：文章与更新记录"}</a>
    </p>
    <Markdown class="mb-8"><Content /></Markdown>
    <Comment path="/about" />
  </article>
</MainGridLayout>
