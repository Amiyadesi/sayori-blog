---
import { Icon } from "astro-icon/components";

import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	buildGardenCatalog,
	GARDEN_TOPICS,
	getStageLabel,
	getTopicCopy,
} from "@utils/garden-utils";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { isEnglishSite, isExtraLocale, isTraditionalSite } from "@utils/site-locale";
import "@/styles/garden.css";

const posts = await getSortedPosts();
const catalog = buildGardenCatalog(posts);

const totalLinks = catalog.allNodes.reduce(
	(total, node) => total + node.outbound.length,
	0,
);
const stageCounts = {
	seedling: catalog.allNodes.filter((node) => node.stage === "seedling").length,
	budding: catalog.allNodes.filter((node) => node.stage === "budding").length,
	evergreen: catalog.allNodes.filter((node) => node.stage === "evergreen").length,
};

const copy = isEnglishSite || isExtraLocale
	? {
			title: "Garden",
			notes: "notes",
			links: "links",
			greenhouses: "greenhouses",
			stageLabel: "Stage",
			topicLabel: "Greenhouse",
			all: "All",
			reset: "Reset view",
			hint: "Click a node to read it · double-click to open · drag empty space to pan · scroll to zoom",
			open: "Open this note",
			related: "Connected notes",
			tended: "Tended",
			revisions: "{count} revisions",
			linksCount: "{count} links",
			siblings: "This greenhouse holds {count} notes.",
		}
	: isTraditionalSite
		? {
				title: "花園",
				notes: "篇筆記",
				links: "條連結",
				greenhouses: "間溫室",
				stageLabel: "生長階段",
				topicLabel: "溫室",
				all: "全部",
				reset: "重置視圖",
				hint: "點擊節點查看 · 雙擊直接打開 · 拖動空白處平移 · 滾輪縮放",
				open: "打開這篇筆記",
				related: "關聯筆記",
				tended: "修剪於",
				revisions: "修剪 {count} 次",
				linksCount: "{count} 條連結",
				siblings: "這間溫室共 {count} 篇筆記。",
			}
		: {
				title: "花园",
				notes: "篇笔记",
				links: "条链接",
				greenhouses: "间温室",
				stageLabel: "生长阶段",
				topicLabel: "温室",
				all: "全部",
				reset: "重置视图",
				hint: "点击节点查看 · 双击直接打开 · 拖动空白处平移 · 滚轮缩放",
				open: "打开这篇笔记",
				related: "关联笔记",
				tended: "修剪于",
				revisions: "修剪 {count} 次",
				linksCount: "{count} 条链接",
				siblings: "这间温室共 {count} 篇笔记。",
			};

const stages = [
	{ id: "all", label: copy.all, icon: "✦", count: catalog.allNodes.length },
	{ id: "seedling", ...getStageLabel("seedling"), count: stageCounts.seedling },
	{ id: "budding", ...getStageLabel("budding"), count: stageCounts.budding },
	{ id: "evergreen", ...getStageLabel("evergreen"), count: stageCounts.evergreen },
];

const labels = {
	tended: copy.tended,
	revisions: copy.revisions,
	linksCount: copy.linksCount,
	open: copy.open,
	related: copy.related,
	siblings: copy.siblings,
	"stage.seedling": getStageLabel("seedling").name,
	"stage.budding": getStageLabel("budding").name,
	"stage.evergreen": getStageLabel("evergreen").name,
};

const graphPayload = {
	labels,
	nodes: catalog.allNodes.map((node) => {
		const topic = GARDEN_TOPICS.find((item) => item.id === node.topicId);
		const neighborMap = new Map<
			string,
			{ slug: string; title: string; url: string; outward: boolean }
		>();
		for (const item of node.outbound) {
			neighborMap.set(item.slug, {
				slug: item.slug,
				title: item.title,
				url: item.url,
				outward: true,
			});
		}
		for (const item of node.backlinks) {
			if (neighborMap.has(item.slug)) continue;
			neighborMap.set(item.slug, {
				slug: item.slug,
				title: item.title,
				url: item.url,
				outward: false,
			});
		}
		const neighbors = [...neighborMap.values()];
		return {
			slug: node.slug,
			title: node.title,
			description: node.description,
			url: node.url,
			topicId: node.topicId,
			topicTitle: topic ? getTopicCopy(topic).title : "",
			topicIcon: topic?.icon ?? "",
			accent: topic?.accent ?? "#506347",
			stage: node.stage,
			degree: node.degree,
			lastTended: formatDateToYYYYMMDD(node.lastTended),
			updateCount: node.updateCount,
			neighbors,
		};
	}),
	edges: catalog.allNodes.flatMap((node) =>
		node.outbound.map((item) => [node.slug, item.slug] as [string, string]),
	),
};
---

<MainGridLayout title={copy.title}>
	<div class="garden-stage" data-garden-stage>
		<canvas
			class="garden-canvas"
			data-garden-graph
			role="img"
			aria-label={copy.title}
		/>

		<div class="garden-hud garden-hud--filters" data-garden-filters>
			<header class="garden-hud__head">
				<p class="garden-hud__eyebrow">DIGITAL GARDEN</p>
				<h1 class="garden-hud__title">{copy.title}</h1>
				<p class="garden-hud__stats">
					<span>{catalog.allNodes.length} {copy.notes}</span>
					<span aria-hidden="true">·</span>
					<span>{totalLinks} {copy.links}</span>
					<span aria-hidden="true">·</span>
					<span>{catalog.topics.length} {copy.greenhouses}</span>
				</p>
			</header>

			<section class="garden-hud__group">
				<h2 class="garden-hud__label">{copy.stageLabel}</h2>
				<div class="garden-chips">
					{stages.map((stage) => (
						<button
							type="button"
							class="garden-chip"
							data-garden-stage={stage.id}
							aria-pressed={stage.id === "all" ? "true" : "false"}
						>
							<span aria-hidden="true">{stage.icon}</span>
							<span>{stage.label}</span>
							<span class="garden-chip__count">{stage.count}</span>
						</button>
					))}
				</div>
			</section>

			<section class="garden-hud__group">
				<h2 class="garden-hud__label">{copy.topicLabel}</h2>
				<div class="garden-chips garden-chips--topics">
					{catalog.topics.map((topic) => (
						<button
							type="button"
							class="garden-chip garden-chip--topic"
							data-garden-topic={topic.id}
							aria-pressed="false"
							style={`--chip-accent: ${topic.accent};`}
						>
							<span class="garden-chip__dot" aria-hidden="true" />
							<span class="garden-chip__label">{topic.copy.title}</span>
							<span class="garden-chip__count">{topic.nodes.length}</span>
						</button>
					))}
				</div>
			</section>
		</div>

		<aside class="garden-hud garden-hud--detail" data-garden-detail hidden>
			<button
				type="button"
				class="garden-detail__close"
				data-garden-detail-close
				aria-label={isEnglishSite ? "Close" : "关闭"}
			>
				<Icon name="material-symbols:close-rounded" />
			</button>
			<div class="garden-detail__inner" data-garden-detail-body />
		</aside>

		<div class="garden-hud garden-hud--bar" data-garden-bar>
			<p class="garden-hud__hint">{copy.hint}</p>
			<button type="button" class="garden-hud__reset" data-garden-graph-reset>
				<Icon name="material-symbols:refresh-rounded" />
				<span>{copy.reset}</span>
			</button>
		</div>
	</div>

	<noscript>
		<div class="garden-fallback">
			{
				catalog.topics.map((topic) => (
					<section id={`topic-${topic.id}`}>
						<h2>{topic.icon} {topic.copy.title}</h2>
						<ul>
							{topic.nodes.map((node) => (
								<li>
									<a href={node.url}>{node.title}</a>
									<span> · {formatDateToYYYYMMDD(node.lastTended)}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</noscript>

	<script is:inline type="application/json" id="garden-graph-data" set:html={JSON.stringify(graphPayload)} />
</MainGridLayout>

<script>
	import "@/scripts/garden-graph";
</script>
