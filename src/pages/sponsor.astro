---
import { PageHeader } from "@components/features/page-header";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";

import { profileConfig, siteConfig, sponsorConfig } from "../config";
import {
	DEFAULT_DONATION_CURRENCY,
	DONATION_CURRENCIES,
} from "../data/donation-currencies.js";
import { currentLocalePath } from "../utils/site-locale";

const sponsorPost = await getEntry("site", "sponsor");

if (!sponsorPost) {
	throw new Error("Sponsor page content not found");
}

const { Content } = await render(sponsorPost);
const isEnglish = siteConfig.lang.startsWith("en");
const title = isEnglish ? "Support" : "赞助";
const description = isEnglish
	? "Support Amiya_desi's blog and public projects through Stripe, Ko-fi, or Afdian. Choose a currency, use a preset, or enter a custom amount."
	: "通过 Stripe、Ko-fi 或爱发电支持 Amiya_desi 的博客和公开项目。可选择币种、预设金额，或填写自定义金额。";
const findProfileLink = (match: (value: string) => boolean) =>
	profileConfig.links.find((link) => match(`${link.name} ${link.url}`))?.url;
const kofiUrl =
	findProfileLink((value) => /ko-fi|kofi/i.test(value)) ||
	"https://ko-fi.com/amiya_desi/tip";
const afdianUrl =
	findProfileLink((value) => /ifdian|afdian|爱发电|愛發電/i.test(value)) ||
	"https://ifdian.net/a/amiya_desi/plan";
const defaultDonationCurrency =
	DONATION_CURRENCIES.find(
		(currency) => currency.code === DEFAULT_DONATION_CURRENCY,
	) || DONATION_CURRENCIES[0];
const formatDonationAmount = (amount: number, decimals: number) =>
	amount.toFixed(decimals);
const sponsorOptions = [
	{
		name: "Ko-fi",
		href: kofiUrl,
		image: "/assets/sponsor/amiya_desi-Sharable-Profile-Vertical.jpg",
		description: siteConfig.lang.startsWith("en")
			? "Support via Ko-fi"
			: "通过 Ko-fi 支持",
		icon: "material-symbols:local-cafe",
	},
	{
		name: isEnglish ? "Afdian" : "爱发电",
		href: afdianUrl,
		image: "/assets/sponsor/afdian-Amiya_desi.jpg",
		description: isEnglish ? "Support via Afdian" : "通过爱发电支持",
		icon: "material-symbols:favorite",
	},
	{
		name: isEnglish ? "Reward code" : "赞赏码",
		image: "/assets/sponsor/amiya-desi-reward-code.png",
		description: isEnglish ? "Scan to support" : "扫描赞赏码支持",
		icon: "material-symbols:qr-code-2",
		fit: "contain",
	},
];
const pageUrl = new URL(
	currentLocalePath(Astro.url.pathname),
	siteConfig.siteURL,
).toString();
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": `${pageUrl}#webpage`,
	url: pageUrl,
	name: `${title} - ${siteConfig.title}`,
	description,
	isPartOf: {
		"@id": `${new URL(siteConfig.siteURL).href}#blog`,
	},
};
---

<MainGridLayout title={title} description={description}>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<section
		class="flex w-full rounded-[var(--radius-large)] overflow-visible relative min-h-32"
	>
		<div
			class="card-base paper-note paper-note-lined paper-tape sponsor-page z-10 px-5 sm:px-9 py-6 relative w-full"
			style="padding-top: 1.75rem;"
		>
			<PageHeader title={title} subtitle={description} />

			<Markdown class="sponsor-copy mt-2">
				<Content />
			</Markdown>

			<div
				class="sponsor-options"
				aria-label={isEnglish ? "Support options" : "赞助方式"}
			>
				{
					sponsorOptions.map((option) => {
						const content = (
							<>
								<img
									class:list={{
										"sponsor-option-image-contain":
											option.fit === "contain",
									}}
									src={option.image}
									alt={option.description}
									loading="lazy"
								/>
								<span class="sponsor-option-label">
									<Icon name={option.icon} />
									{option.name}
								</span>
							</>
						);

						return option.href ? (
							<a
								class="sponsor-option"
								href={option.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={option.description}
							>
								{content}
							</a>
						) : (
							<div
								class="sponsor-option sponsor-option-static"
								aria-label={option.description}
							>
								{content}
							</div>
						);
					})
				}
			</div>

			<section
				class="stripe-support-card"
				aria-labelledby="stripe-support-title"
			>
				<h2 id="stripe-support-title">
					{
						isEnglish
							? "Support directly with Stripe"
							: "使用 Stripe 直接支持"
					}
				</h2>
				<p>
					{
						isEnglish
							? "Choose a currency and amount, or enter your own. Your display name is optional and will appear in the supporter list after payment."
							: "选择币种和金额，也可以自定义填写。显示名称可选，支付完成后会出现在支持人名单中。"
					}
				</p>
				<form
					data-stripe-support-form
					data-currency-config={JSON.stringify(DONATION_CURRENCIES)}
				>
					<label>
						<span>{isEnglish ? "Currency" : "币种"}</span>
						<select name="currency" data-stripe-currency>
							{
								DONATION_CURRENCIES.map((currency) => (
									<option
										value={currency.code}
										selected={
											currency.code ===
											defaultDonationCurrency.code
										}
									>
										{isEnglish
											? currency.labelEn
											: currency.labelZh}
									</option>
								))
							}
						</select>
					</label>
					<label>
						<span data-stripe-amount-label>
							{
								isEnglish
									? `Amount (${defaultDonationCurrency.code.toUpperCase()})`
									: `金额（${defaultDonationCurrency.code.toUpperCase()}）`
							}
						</span>
						<input
							type="number"
							name="amount"
							min={defaultDonationCurrency.minimum}
							max={defaultDonationCurrency.maximum}
							step={defaultDonationCurrency.decimals
								? "0.01"
								: "1"}
							value={formatDonationAmount(
								defaultDonationCurrency.presets[0],
								defaultDonationCurrency.decimals,
							)}
							inputmode={defaultDonationCurrency.decimals
								? "decimal"
								: "numeric"}
							data-stripe-amount
							required
						/>
					</label>
					<div
						class="stripe-presets"
						data-stripe-presets
						role="group"
						aria-label={isEnglish
							? "Suggested amounts"
							: "预设金额"}
					>
						{
							defaultDonationCurrency.presets.map(
								(amount, index) => (
									<button
										type="button"
										class="stripe-preset"
										data-stripe-preset
										data-value={amount}
										aria-pressed={
											index === 0 ? "true" : "false"
										}
									>
										{defaultDonationCurrency.symbol}
										{formatDonationAmount(
											amount,
											defaultDonationCurrency.decimals,
										)}
									</button>
								),
							)
						}
					</div>
					<label>
						<span
							>{
								isEnglish
									? "Display name (optional)"
									: "显示名称（可选）"
							}</span
						>
						<input
							type="text"
							name="name"
							maxlength="80"
							autocomplete="nickname"
							placeholder={isEnglish
								? "Anonymous supporter"
								: "匿名支持者"}
						/>
					</label>
					<button type="submit" class="stripe-support-submit">
						{isEnglish ? "Continue to Stripe" : "前往 Stripe 支付"}
					</button>
					<p
						data-stripe-support-status
						role="status"
						aria-live="polite"
					>
					</p>
				</form>
			</section>

			<section
				class="sponsor-thanks"
				aria-labelledby="sponsor-thanks-title"
			>
				<h2 id="sponsor-thanks-title">
					{isEnglish ? "Thanks for your support" : "感谢赞助"}
				</h2>
				{
					sponsorConfig.supporters.length > 0 ? (
						<ul data-supporters-list>
							{sponsorConfig.supporters.map((supporter) => (
								<li>
									<span>{supporter.name}</span>
									{supporter.source && (
										<small>{supporter.source}</small>
									)}
								</li>
							))}
						</ul>
					) : (
						<p>
							{isEnglish
								? "Thank you to everyone willing to support this desk."
								: "感谢每一个愿意支持这里的人。"}
						</p>
					)
				}
			</section>
		</div>
	</section>
</MainGridLayout>

<script>
	function renderSupporters(
		supporters: Array<{ name?: string; source?: string }>,
	) {
		const supporterList = document.querySelector<HTMLUListElement>(
			"[data-supporters-list]",
		);
		const englishPage = document.documentElement.lang?.startsWith("en");
		if (
			!supporterList ||
			!Array.isArray(supporters) ||
			supporters.length === 0
		)
			return;
		supporterList.replaceChildren();
		for (const supporter of supporters) {
			const item = document.createElement("li");
			const name = document.createElement("span");
			name.textContent = supporter.name || "匿名支持者";
			item.append(name);
			if (supporter.source) {
				const source = document.createElement("small");
				source.textContent =
					englishPage && supporter.source === "爱发电"
						? "Afdian"
						: supporter.source;
				item.append(source);
			}
			supporterList.append(item);
		}
	}

	async function refreshSupporters() {
		try {
			const response = await fetch("/api/supporters", {
				cache: "no-store",
				headers: { accept: "application/json" },
			});
			if (!response.ok) return;
			const data = await response.json();
			renderSupporters(data.supporters);
		} catch {
			// Keep statically generated supporters when Functions are unavailable.
		}
	}

	function bindSupportForm() {
		const supportForm = document.querySelector<HTMLFormElement>(
			"[data-stripe-support-form]",
		);
		const supportStatus = document.querySelector<HTMLElement>(
			"[data-stripe-support-status]",
		);
		if (!supportForm || supportForm.dataset.bound === "true") return;
		supportForm.dataset.bound = "true";
		const currencyField = supportForm.querySelector<HTMLSelectElement>(
			"[data-stripe-currency]",
		);
		const amountField = supportForm.querySelector<HTMLInputElement>(
			"[data-stripe-amount]",
		);
		const amountLabel = supportForm.querySelector<HTMLElement>(
			"[data-stripe-amount-label]",
		);
		const presets = supportForm.querySelector<HTMLElement>(
			"[data-stripe-presets]",
		);
		const currencies = JSON.parse(
			supportForm.dataset.currencyConfig || "[]",
		) as Array<{
			code: string;
			labelEn: string;
			labelZh: string;
			symbol: string;
			decimals: number;
			minimum: number;
			maximum: number;
			presets: number[];
		}>;
		const englishPage = document.documentElement.lang?.startsWith("en");

		function formatAmount(amount: number, decimals: number) {
			return amount.toFixed(decimals);
		}

		function getCurrency() {
			return (
				currencies.find(
					(currency) => currency.code === currencyField?.value,
				) || currencies[0]
			);
		}

		function syncPresetState() {
			const currentAmount = amountField?.value;
			presets
				?.querySelectorAll<HTMLButtonElement>("[data-stripe-preset]")
				.forEach((preset) => {
					preset.setAttribute(
						"aria-pressed",
						preset.dataset.value === currentAmount
							? "true"
							: "false",
					);
				});
		}

		function renderPresets(currency: (typeof currencies)[number]) {
			if (!presets) return;
			presets.replaceChildren();
			for (const amount of currency.presets) {
				const preset = document.createElement("button");
				preset.type = "button";
				preset.className = "stripe-preset";
				preset.dataset.stripePreset = "";
				preset.dataset.value = formatAmount(amount, currency.decimals);
				preset.textContent = `${currency.symbol}${formatAmount(amount, currency.decimals)}`;
				preset.addEventListener("click", () => {
					if (amountField)
						amountField.value = preset.dataset.value || "";
					syncPresetState();
				});
				presets.append(preset);
			}
			syncPresetState();
		}

		function syncCurrency(resetAmount = false) {
			const currency = getCurrency();
			if (!currency || !amountField) return;
			amountField.min = String(currency.minimum);
			amountField.max = String(currency.maximum);
			amountField.step = currency.decimals ? "0.01" : "1";
			amountField.inputMode = currency.decimals ? "decimal" : "numeric";
			if (resetAmount) {
				amountField.value = formatAmount(
					currency.presets[0],
					currency.decimals,
				);
			}
			if (amountLabel) {
				amountLabel.textContent = englishPage
					? `Amount (${currency.code.toUpperCase()})`
					: `金额（${currency.code.toUpperCase()}）`;
			}
			renderPresets(currency);
		}

		syncCurrency();
		currencyField?.addEventListener("change", () => syncCurrency(true));
		amountField?.addEventListener("input", syncPresetState);
		supportForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			const button = supportForm.querySelector<HTMLButtonElement>(
				"button[type='submit']",
			);
			const formData = new FormData(supportForm);
			if (supportStatus) supportStatus.textContent = "";
			if (button) button.disabled = true;
			try {
				const response = await fetch("/api/stripe/checkout", {
					method: "POST",
					headers: {
						"content-type": "application/json",
						accept: "application/json",
					},
					body: JSON.stringify({
						amount: formData.get("amount"),
						currency: formData.get("currency"),
						name: formData.get("name"),
					}),
				});
				const data = await response.json().catch(() => ({}));
				if (!response.ok || !data.url) {
					throw new Error(
						data.error || "Stripe checkout unavailable",
					);
				}
				window.location.assign(data.url);
			} catch (error) {
				if (supportStatus) {
					supportStatus.textContent =
						error instanceof Error
							? error.message
							: "暂时无法打开 Stripe 支付";
				}
				if (button) button.disabled = false;
			}
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		bindSupportForm();
		refreshSupporters();
	});
	document.addEventListener("mizuki:page:loaded", () => {
		bindSupportForm();
		refreshSupporters();
	});
</script>

<style>
	.sponsor-page {
		--sponsor-border: color-mix(
			in srgb,
			var(--primary) 18%,
			var(--line-divider)
		);
	}

	.sponsor-options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.sponsor-option {
		position: relative;
		display: block;
		overflow: hidden;
		border: 1px solid var(--sponsor-border);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.48);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.sponsor-option:not(.sponsor-option-static):hover {
		transform: translateY(-2px);
		border-color: color-mix(
			in srgb,
			var(--primary) 42%,
			var(--line-divider)
		);
		box-shadow: 0 12px 28px rgba(84, 50, 67, 0.1);
	}

	.sponsor-option img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: rgba(0, 0, 0, 0.04);
	}

	.sponsor-option img.sponsor-option-image-contain {
		object-fit: contain;
		background: #17191d;
	}

	.sponsor-option-label {
		position: absolute;
		left: 0.75rem;
		bottom: 0.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.88);
		padding: 0.42rem 0.7rem;
		font-size: 0.86rem;
		font-weight: 800;
		color: rgba(0, 0, 0, 0.78);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
	}

	.sponsor-option-label :global(svg) {
		font-size: 1.05rem;
		color: var(--primary);
	}

	.stripe-support-card {
		margin-top: 1.5rem;
		border: 1px solid var(--sponsor-border);
		border-radius: 0.65rem;
		background: color-mix(in srgb, var(--primary) 5%, transparent);
		padding: 1rem 1.1rem 1.1rem;
	}

	.stripe-support-card h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 800;
	}

	.stripe-support-card p {
		margin: 0.45rem 0 0.9rem;
		color: rgba(0, 0, 0, 0.58);
	}

	.stripe-support-card form {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
		align-items: end;
	}

	.stripe-support-card label {
		display: grid;
		gap: 0.35rem;
		font-size: 0.88rem;
		font-weight: 700;
	}

	.stripe-support-card input {
		width: 100%;
		border: 1px solid var(--line-divider);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.72);
		padding: 0.6rem 0.7rem;
		color: inherit;
	}

	.stripe-support-card select {
		width: 100%;
		border: 1px solid var(--line-divider);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.72);
		padding: 0.6rem 0.7rem;
		color: inherit;
	}

	.stripe-presets {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		grid-column: 1 / -1;
	}

	.stripe-preset {
		border: 1px solid var(--sponsor-border);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.56);
		padding: 0.48rem 0.8rem;
		font: inherit;
		font-size: 0.88rem;
		font-weight: 800;
		color: inherit;
		cursor: pointer;
	}

	.stripe-preset[aria-pressed="true"] {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 13%, transparent);
		color: var(--primary);
	}

	.stripe-support-submit {
		grid-column: 1 / -1;
		justify-self: start;
		border: 0;
		border-radius: 999px;
		background: var(--primary);
		padding: 0.62rem 1rem;
		font-weight: 800;
		color: white;
		cursor: pointer;
	}

	.stripe-support-submit:disabled {
		cursor: wait;
		opacity: 0.6;
	}

	[data-stripe-support-status] {
		grid-column: 1 / -1;
		min-height: 1.2rem;
		margin: 0;
		color: var(--primary);
	}

	.sponsor-thanks {
		margin-top: 1.75rem;
		border-top: 1px dashed var(--line-divider);
		padding-top: 1.35rem;
	}

	.sponsor-thanks h2 {
		margin: 0 0 0.85rem;
		font-size: 1.25rem;
		font-weight: 800;
		color: rgba(0, 0, 0, 0.86);
	}

	.sponsor-thanks ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sponsor-thanks li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border: 1px dashed var(--sponsor-border);
		border-radius: 0.5rem;
		background: rgba(255, 255, 255, 0.36);
		padding: 0.7rem 0.8rem;
	}

	.sponsor-thanks span {
		min-width: 0;
		font-weight: 800;
		color: rgba(0, 0, 0, 0.78);
		overflow-wrap: anywhere;
	}

	.sponsor-thanks small,
	.sponsor-thanks p {
		color: rgba(0, 0, 0, 0.52);
	}

	:global(.dark) .sponsor-option,
	:global(.dark) .sponsor-thanks li {
		background: rgba(255, 255, 255, 0.045);
	}

	:global(.dark) .sponsor-thanks h2,
	:global(.dark) .sponsor-thanks span {
		color: rgba(255, 255, 255, 0.86);
	}

	:global(.dark) .sponsor-option-label {
		background: rgba(20, 20, 24, 0.86);
		color: rgba(255, 255, 255, 0.86);
	}

	:global(.dark) .stripe-support-card p {
		color: rgba(255, 255, 255, 0.58);
	}

	:global(.dark) .stripe-support-card input {
		background: rgba(255, 255, 255, 0.06);
	}

	:global(.dark) .stripe-support-card select,
	:global(.dark) .stripe-preset {
		background: rgba(255, 255, 255, 0.06);
	}

	:global(.dark) .sponsor-thanks small,
	:global(.dark) .sponsor-thanks p {
		color: rgba(255, 255, 255, 0.56);
	}

	@media (max-width: 900px) {
		.sponsor-options {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.stripe-support-card form {
			grid-template-columns: 1fr;
		}

		.sponsor-options {
			grid-template-columns: 1fr;
		}
	}
</style>
