---
import Footer from "@components/organisms/footer/Footer.astro";
import Navbar from "@components/organisms/navigation/Navbar.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import { relatedPostsConfig } from "../config";
import { getRelatedPosts } from "../utils/content-utils";
import { getPostUrl } from "../utils/url-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import {
	currentLocalePath,
	isEnglishSite,
	isTraditionalSite,
	type HreflangMap,
} from "../utils/site-locale";
import Layout from "./Layout.astro";
interface Props {
	title?: string; banner?: string; description?: string; lang?: string;
	setOGTypeArticle?: boolean; postSlug?: string; headings?: MarkdownHeading[];
	coverImage?: string; ogImageAlt?: string; publishedTime?: Date | string;
	modifiedTime?: Date | string; tags?: string[]; noindex?: boolean;
	alternateUrls?: HreflangMap;
	post?: CollectionEntry<"posts">;
}
const { headings = [], post, ...metadata } = Astro.props;
const isPost = Boolean(metadata.postSlug);
const relatedPosts = post && relatedPostsConfig.enable
	? await getRelatedPosts(post, relatedPostsConfig.maxCount)
	: [];
const relatedHeading = i18n(I18nKey.relatedPosts);
const tocHeading = isEnglishSite
	? "On this page"
	: isTraditionalSite
		? "文章目錄"
		: "文章目录";
const tocLabel = isEnglishSite ? "Table of contents" : tocHeading;
const homeLabel = isEnglishSite ? "Home" : isTraditionalSite ? "返回首頁" : "返回首页";
const topLabel = isEnglishSite ? "Back to top" : isTraditionalSite ? "回到頂部" : "回到顶部";
// rehype-autolink-headings appends one visual # after the authored heading.
const toc = headings.filter(heading => heading.depth < 4).map(heading => ({
	...heading,
	text: heading.text.replace(/#$/, ""),
}));
const firstDepth = Math.min(...toc.map(heading => heading.depth));
---
<Layout {...metadata}>
	<slot slot="head" name="head" />
	<Navbar />
	<div class:list={["desk-shell", { "reading-shell": isPost }]}>
		{isPost && relatedPosts.length > 0 && (
			<aside class="reading-related" data-pagefind-ignore>
				<details id="reading-related" open>
					<summary>{relatedHeading}</summary>
					<nav aria-label={relatedHeading}>
						<ol>
							{relatedPosts.map((post) => (
								<li>
									<a href={getPostUrl(post)}>
										<span>{post.data.title}</span>
										<time datetime={formatDateToYYYYMMDD(post.data.published)}>
											{formatDateToYYYYMMDD(post.data.published)}
										</time>
									</a>
								</li>
							))}
						</ol>
					</nav>
				</details>
			</aside>
		)}
		{isPost && (
			<aside class="reading-toc" data-pagefind-ignore>
				<div class="reading-rail">
				{toc.length > 0 && <details id="reading-toc" open>
					<summary>{tocHeading}</summary>
					<nav aria-label={tocLabel}>
						<ol>{toc.map(heading => <li class:list={[{ "toc-subheading": heading.depth > firstDepth }]}><a href={"#" + heading.slug}>{heading.text}</a></li>)}</ol>
					</nav>
				</details>}
				<nav class="reading-actions" aria-label={isEnglishSite ? "Reading shortcuts" : isTraditionalSite ? "閱讀捷徑" : "阅读快捷入口"}>
					<a href={currentLocalePath("/")} aria-label={homeLabel} title={homeLabel}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8" /></svg>
						<span>{homeLabel}</span>
					</a>
					<a href="#page-top" aria-label={topLabel} title={topLabel}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V4m-7 7 7-7 7 7" /></svg>
						<span>{topLabel}</span>
					</a>
				</nav>
				</div>
			</aside>
		)}
		<main id="swup-container" tabindex="-1"><slot /></main>
	</div>
	<Footer />
</Layout>
<script>
	const readingDesktop = matchMedia("(min-width: 1280px)");
	function initReadingRails() {
		const expanded = readingDesktop.matches;
		for (const id of ["reading-toc", "reading-related"]) {
			const details = document.getElementById(id);
			if (details instanceof HTMLDetailsElement) {
				details.name = expanded ? "" : "reading-rails";
				details.open = expanded;
			}
		}
	}
	initReadingRails();
	document.addEventListener("astro:page-load", initReadingRails);
	readingDesktop.addEventListener("change", initReadingRails);
	document.addEventListener("click", event => {
		if (readingDesktop.matches || !(event.target instanceof Element)) return;
		for (const details of document.querySelectorAll<HTMLDetailsElement>("#reading-toc[open], #reading-related[open]")) {
			if (!details.contains(event.target) || event.target.closest("a")) details.open = false;
		}
	});
	document.addEventListener("keydown", event => {
		if (readingDesktop.matches || event.key !== "Escape") return;
		for (const details of document.querySelectorAll<HTMLDetailsElement>("#reading-toc[open], #reading-related[open]")) {
			details.open = false;
			details.querySelector("summary")?.focus();
		}
	});
</script>
