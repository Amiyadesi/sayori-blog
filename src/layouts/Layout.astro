---
import CopyFeedback from "@components/misc/CopyFeedback.astro";
import { ClientRouter } from "astro:transitions";
import OptionalFeatures from "@components/features/settings/OptionalFeatures.astro";
import { siteConfig } from "@/config";
import { SITE_LOCALE, type HreflangMap } from "@utils/site-locale";
import "../styles/variables.styl";
import "../styles/main.css";
import AnalyticsScripts from "./partials/AnalyticsScripts.astro";
import HeadTags from "./partials/HeadTags.astro";

interface Props {
	title?: string; banner?: string; description?: string; lang?: string;
	setOGTypeArticle?: boolean; postSlug?: string; coverImage?: string;
	ogImageAlt?: string; publishedTime?: Date | string; modifiedTime?: Date | string;
	tags?: string[]; noindex?: boolean; alternateUrls?: HreflangMap;
}
const { title, description, setOGTypeArticle, postSlug, coverImage, ogImageAlt,
	publishedTime, modifiedTime, tags, noindex, alternateUrls } = Astro.props;
const pageTitle = title ? title + " - " + siteConfig.title : siteConfig.title +
	(SITE_LOCALE === "en" ? " | Notes & Projects" : "｜笔记与项目");
const ogImageUrl = new URL(siteConfig.generateOgImages && postSlug
	? "/og/" + postSlug + ".png"
	: coverImage || "/assets/desktop-banner/1.webp", Astro.site).toString();
---
<!doctype html>
<html transition:animate="none" data-pagefind-ignore={noindex ? "all" : undefined} lang={SITE_LOCALE} data-pagefind-filter={"locale:" + SITE_LOCALE}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline src="/p34-entry.js?v=20261108-revision"></script>
        <script is:inline data-astro-rerun>
          if (!window.__p34OwnPopstateGate) {
            window.__p34OwnPopstateGate = true;
            window.addEventListener('popstate', event => {
              if (document.documentElement.dataset.p34Active === 'true' && new URLSearchParams(location.search).get('paper') === '0617') {
                event.stopImmediatePropagation();
                window.dispatchEvent(new Event('p34:navigate'));
              }
            }, true);
          }
          if (new URLSearchParams(location.search).get('paper') === '0617') {
            const root = document.documentElement;
            root.classList.add('p34-luminous');
            root.dataset.p34Active = 'true';
            if (!document.querySelector('link[data-p34-reading-style]')) {
              const style = document.createElement('link');
              style.rel = 'stylesheet';
              style.href = '/p34-reading.css?v=20261108-revision';
              style.dataset.p34ReadingStyle = '';
              document.head.append(style);
            }
          }
        </script>
		{process.env.SITE_VARIANT !== "sayori-diary" && <ClientRouter fallback="swap" />}
		{process.env.P34_LOCAL_PREVIEW !== "1" && <AnalyticsScripts thirdPartyAnalytics={siteConfig.thirdPartyAnalytics} />}
		<HeadTags title={pageTitle} description={description} ogImageUrl={ogImageUrl}
			ogImageAlt={ogImageAlt} setOGTypeArticle={setOGTypeArticle}
			publishedTime={publishedTime} modifiedTime={modifiedTime} tags={tags}
			configHue={siteConfig.themeColor.hue} noindex={noindex} alternateUrls={alternateUrls} />
		<slot name="head" />
	</head>
	<body class="desk-lite">
		<a class="skip-link" href="#swup-container">{SITE_LOCALE === "en" ? "Skip to main content" : "跳到主要内容"}</a>
		<CopyFeedback />
		<slot />
		<OptionalFeatures />
		<div id="twikoo-runtime-host" hidden transition:persist="twikoo-runtime"></div>
		{process.env.SITE_VARIANT !== "sayori-diary" && <script is:inline>
      // Normal pages load only this gate, never the anomaly module or stylesheet.
      if (!window.__p34ReadingGate) {
        let generation = 0;
        let dispose;
        const clearPaper = () => {
          generation++;
          if (typeof dispose === "function") dispose();
          dispose = undefined;
          if (new URLSearchParams(location.search).get("paper") !== "0617") {
            const root = document.documentElement;
            root.classList.remove("p34-luminous", "p34-world", "p34-ready", "p34-talking", "p34-chat-open");
            for (const key of ["p34Active", "p34Site", "p34Entry", "p34Chapter", "p34Mood", "p34Scene", "p34Pose", "p34Moment"]) {
              delete root.dataset[key];
            }
            document.querySelectorAll("link[data-p34-reading-style], link[data-p34-living-style]").forEach(el => el.remove());
          }
        };
        const syncPaper = async () => {
          clearPaper();
          if (new URLSearchParams(location.search).get("paper") !== "0617") return;
          const current = generation;
          try {
            const modulePath = "/paper-blog.js?v=20261108-revision";
            const { mountPaperBlog } = await import(/* @vite-ignore */ modulePath);
            if (current !== generation) return;
            const mounted = await mountPaperBlog(() => current === generation);
            if (current === generation) dispose = mounted;
            else mounted();
          } catch (error) {
            console.error("Paper stock unavailable", error);
            window.dispatchEvent(new Event("p34:entry-error"));
          }
        };
        window.__p34ReadingGate = { clearPaper, syncPaper };
        document.addEventListener("astro:page-load", () => void syncPaper());
        document.addEventListener("astro:before-swap", event => {
          clearPaper();
          const next = event.newDocument?.documentElement;
          if (!next) return;
          if (new URL(event.to).searchParams.get("paper") === "0617") {
            next.classList.add("p34-luminous");
            next.dataset.p34Active = "true";
            if (!event.newDocument.querySelector("link[data-p34-reading-style]")) {
              const style = event.newDocument.createElement("link");
              style.rel = "stylesheet";
              style.href = "/p34-reading.css?v=20261108-revision";
              style.dataset.p34ReadingStyle = "";
              event.newDocument.head.append(style);
            }
          } else {
            next.classList.remove("p34-luminous", "p34-world", "p34-ready", "p34-talking", "p34-chat-open");
            delete next.dataset.p34Active;
            event.newDocument.querySelectorAll("link[data-p34-reading-style], link[data-p34-living-style]").forEach(el => el.remove());
          }
        });
        window.addEventListener("popstate", () => {
          if (typeof dispose === "function" && new URLSearchParams(location.search).get("paper") === "0617") {
            window.dispatchEvent(new Event("p34:navigate"));
            return;
          }
          void syncPaper();
        });
        window.addEventListener("pageshow", event => {
          if (event.persisted && !document.querySelector("#p34-space")) void syncPaper();
        });
      }
    </script>}
	</body>
</html>

<script>
	// Earlier blog versions installed a worker; update it without installing one for new visitors.
	if ("serviceWorker" in navigator && navigator.serviceWorker.controller?.scriptURL === new URL("/sw.js", location.origin).href) {
		navigator.serviceWorker.getRegistration("/")
			.then(registration => registration?.update())
			.catch(error => console.error("Legacy service worker update failed", error));
	}
</script>
