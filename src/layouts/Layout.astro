---
import CopyFeedback from "@components/misc/CopyFeedback.astro";
import { ClientRouter } from "astro:transitions";
import OptionalFeatures from "@components/features/settings/OptionalFeatures.astro";
import { siteConfig } from "@/config";
import { SITE_LOCALE, type HreflangMap } from "@utils/site-locale";
import "../styles/variables.styl";
import "../styles/main.css";
import AnalyticsScripts from "./partials/AnalyticsScripts.astro";
import HeadTags from "./partials/HeadTags.astro";

interface Props {
	title?: string; banner?: string; description?: string; lang?: string;
	setOGTypeArticle?: boolean; postSlug?: string; coverImage?: string;
	ogImageAlt?: string; publishedTime?: Date | string; modifiedTime?: Date | string;
	tags?: string[]; noindex?: boolean; alternateUrls?: HreflangMap;
}
const { title, description, setOGTypeArticle, postSlug, coverImage, ogImageAlt,
	publishedTime, modifiedTime, tags, noindex, alternateUrls } = Astro.props;
const pageTitle = title ? title + " - " + siteConfig.title : siteConfig.title +
	(SITE_LOCALE === "en" ? " | Notes & Projects" : "｜笔记与项目");
const ogImageUrl = new URL(siteConfig.generateOgImages && postSlug
	? "/og/" + postSlug + ".png"
	: coverImage || "/assets/desktop-banner/1.webp", Astro.site).toString();
---
<!doctype html>
<html transition:animate="none" data-pagefind-ignore={noindex ? "all" : undefined} lang={SITE_LOCALE} data-pagefind-filter={"locale:" + SITE_LOCALE}>
	<head>
		<meta charset="UTF-8" />
		{process.env.SITE_VARIANT !== "sayori-diary" && <ClientRouter fallback="swap" />}
		<AnalyticsScripts thirdPartyAnalytics={siteConfig.thirdPartyAnalytics} />
		<HeadTags title={pageTitle} description={description} ogImageUrl={ogImageUrl}
			ogImageAlt={ogImageAlt} setOGTypeArticle={setOGTypeArticle}
			publishedTime={publishedTime} modifiedTime={modifiedTime} tags={tags}
			configHue={siteConfig.themeColor.hue} noindex={noindex} alternateUrls={alternateUrls} />
		<slot name="head" />
	</head>
	<body class="desk-lite">
		<a class="skip-link" href="#swup-container">{SITE_LOCALE === "en" ? "Skip to main content" : "跳到主要内容"}</a>
		<CopyFeedback />
		<slot />
		<OptionalFeatures />
		<div id="twikoo-runtime-host" hidden transition:persist="twikoo-runtime"></div>
	</body>
</html>
