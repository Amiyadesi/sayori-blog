---
import ConfigCarrier from "@components/misc/ConfigCarrier.astro";
import CopyFeedback from "@components/misc/CopyFeedback.astro";
import MusicPlayerHost from "@components/widgets/music-player/MusicPlayerHost.svelte";
import Pio from "@components/features/pio/Pio.svelte"; // 使用 Svelte 版本的 Pio 组件
import InstallPrompt from "@components/features/pwa/InstallPrompt.astro";
import SayoriPet from "@components/features/sayori-pet/SayoriPet.svelte";
import { musicPlayerConfig, pioConfig, siteConfig } from "@/config";
import { SITE_LOCALE, type HreflangMap } from "@utils/site-locale";

const BANNER_HEIGHT = 35;
const BANNER_HEIGHT_EXTEND = 30;
const BANNER_HEIGHT_HOME = BANNER_HEIGHT + BANNER_HEIGHT_EXTEND;

import { PAGE_WIDTH } from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/mobile-navbar.css";
import "../styles/wallpaper-navbar-transparent.css";
import "../styles/panel-animations.css";

// 导入新提取的 Head 组件
import AnalyticsScripts from "./partials/AnalyticsScripts.astro";
import HeadTags from "./partials/HeadTags.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	coverImage?: string;
	ogImageAlt?: string;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	tags?: string[];
	noindex?: boolean;
	alternateUrls?: HreflangMap;
}

let {
	title,
	banner,
	description,
	setOGTypeArticle,
	postSlug,
	coverImage,
	ogImageAlt,
	publishedTime,
	modifiedTime,
	tags,
	noindex,
	alternateUrls,
} = Astro.props;

// Each document owns its banner and reading layout.
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const isAdminPage = Astro.url.pathname.startsWith("/admin");

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";

// 判断是否应该显示顶部高光效果（只在full和semifull模式下显示）
const shouldShowTopHighlight =
	navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

// 获取默认banner图片的辅助函数
const getDefaultBanner = (): string => {
	const src = siteConfig.banner.src;
	if (typeof src === "string") {
		return src;
	}
	if (Array.isArray(src)) {
		return src[0] || "";
	}
	if (src && typeof src === "object") {
		// 优先使用desktop，如果没有则使用mobile
		const desktopSrc = src.desktop;
		const mobileSrc = src.mobile;
		if (typeof desktopSrc === "string") {
			return desktopSrc;
		}
		if (Array.isArray(desktopSrc) && desktopSrc.length > 0) {
			return desktopSrc[0];
		}
		if (typeof mobileSrc === "string") {
			return mobileSrc;
		}
		if (Array.isArray(mobileSrc) && mobileSrc.length > 0) {
			return mobileSrc[0];
		}
	}
	return "";
};

if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = getDefaultBanner();
}

// TODO don't use post cover as banner for now
banner = getDefaultBanner();

const enableBanner = !!siteConfig.banner.src;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	// 首页标题保持短而明确；长描述继续放在 meta description 和页面正文中。
	pageTitle = siteConfig.lang.toLowerCase().startsWith("en")
		? `${siteConfig.title} | Notes & Projects`
		: `${siteConfig.title}｜笔记与项目`;
}

let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
} else if (coverImage) {
	// For post pages with cover images, use the resolved cover image
	ogImageUrl = coverImage.startsWith("http")
		? coverImage
		: new URL(coverImage, Astro.site).toString();
} else if (banner) {
	// For others, use the first banner as OG image
	ogImageUrl = banner.startsWith("http")
		? banner
		: new URL(banner, Astro.site).toString();
}

const siteLang = SITE_LOCALE;

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

// 构建字体配置的 CSS 变量
// ASCII 字体优先级最高（用于英文、数字等），CJK 字体作为回退
let bodyFontFamily = "";
if (siteConfig.font) {
	const fonts: string[] = [];
	// 先添加 ASCII 字体（优先级最高）
	if (siteConfig.font.asciiFont?.fontFamily) {
		const asciiFont = siteConfig.font.asciiFont.fontFamily;
		// 如果字体名包含空格，需要用引号包围
		fonts.push(asciiFont.includes(" ") ? `"${asciiFont}"` : asciiFont);
	}
	// 再添加 CJK 字体（作为回退）
	if (siteConfig.font.cjkFont?.fontFamily) {
		const cjkFont = siteConfig.font.cjkFont.fontFamily;
		// 如果字体名包含空格，需要用引号包围
		fonts.push(cjkFont.includes(" ") ? `"${cjkFont}"` : cjkFont);
	}
	// 添加系统字体作为最终回退
	fonts.push(
		"system-ui",
		"-apple-system",
		"BlinkMacSystemFont",
		"'Segoe UI'",
		"Roboto",
		"Oxygen",
		"Ubuntu",
		"Cantarell",
		"'Open Sans'",
		"'Helvetica Neue'",
		"sans-serif",
	);
	// 组合成完整的 font-family 字符串
	bodyFontFamily = fonts.join(", ");
}
---

<!doctype html>
<html
	lang={siteLang}
	data-pagefind-filter={`locale:${SITE_LOCALE}`}
	class="bg-[var(--page-bg)] text-[14px] md:text-[16px]"
	data-overlayscrollbars-initialize
>
	<head>
		<meta charset="UTF-8" />

		<!-- 第三方分析脚本 -->
		<AnalyticsScripts
			thirdPartyAnalytics={siteConfig.thirdPartyAnalytics}
		/>

		<!-- SEO Meta Tags, Open Graph, Twitter Card, Favicons, Theme Init -->
		<HeadTags
			title={pageTitle}
			description={description}
			ogImageUrl={ogImageUrl}
			ogImageAlt={ogImageAlt}
			setOGTypeArticle={setOGTypeArticle}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			tags={tags}
			configHue={configHue}
			noindex={noindex}
			alternateUrls={alternateUrls}
		/>

		<!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->
		<slot name="head" />
		<link rel="preload" as="image" href="/assets/pet/sayori-neutral.webp" fetchpriority="high" />

		<!-- Global CSS variables for page width and hue -->
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>

		<!-- Pio 看板娘样式 - 非渲染阻塞加载 -->
		{
			pioConfig.enable && (
				<Fragment
					set:html={`<link rel="stylesheet" href="/pio/static/pio.css" media="print" onload="this.media='all'" />`}
				/>
			)
		}
	</head>
	<body
		class="min-h-screen"
		class:list={[
			{
				"lg:is-home": isHomePage,
				"enable-banner": enableBanner,
				"is-admin-page": isAdminPage,
			},
		]}
		style={bodyFontFamily ? `font-family: ${bodyFontFamily};` : ""}
		data-overlayscrollbars-initialize
	>
		<a class="skip-link" href="#swup-container">
			{
				siteLang.toLowerCase().startsWith("en")
					? "Skip to main content"
					: "跳到主要内容"
			}
		</a>
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-KRX3XGVH"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- 页面顶部渐变高光效果 - 只在full和semifull模式下显示 -->
		{shouldShowTopHighlight && <div class="top-gradient-highlight" />}

		<ConfigCarrier />
		<CopyFeedback />
		<slot />

		<!-- Load player controls only when requested on this page. -->
		{musicPlayerConfig.enable && <MusicPlayerHost client:load eager={musicPlayerConfig.floatingEntryMode !== "fab"} />}

		<!-- Pio 看板娘组件 - 仅在进入视口时加载 -->
		{pioConfig.enable && <Pio client:visible />}

		<SayoriPet client:load />
		<InstallPrompt />

	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
	}}
>
	@reference "../styles/main.css";

	@layer components {
		.skip-link {
			position: fixed;
			inset-block-start: 0.75rem;
			inset-inline-start: 0.75rem;
			z-index: 9999;
			padding: 0.55rem 0.8rem;
			border-radius: 999px;
			background: var(--card-bg);
			color: var(--primary);
			font-weight: 700;
			text-decoration: none;
			transform: translateY(-200%);
			transition: transform 150ms ease;
		}
		.skip-link:focus-visible {
			transform: translateY(0);
			outline: 3px solid var(--primary);
			outline-offset: 3px;
		}
		@media (prefers-reduced-motion: reduce) {
			.skip-link {
				transition: none;
			}
		}

		.is-admin-page .sayori-pet,
		.is-admin-page .sayori-pet-tab {
			display: none !important;
		}

		@media (min-width: 1280px) {
			.enable-banner.lg\:is-home #banner-wrapper {
				height: var(--banner-height-home);
				transform: translateY(var(--banner-height-extend));
			}
			.enable-banner #banner-wrapper {
				height: var(--banner-height-home);
			}

			.enable-banner.lg\:is-home #banner {
				height: var(--banner-height-home);
				transform: translateY(0);
			}
			.enable-banner #banner {
				height: var(--banner-height-home);
				transform: translateY(var(--bannerOffset));
			}
			.enable-banner.lg\:is-home #main-grid {
				transform: translateY(var(--banner-height-extend));
			}
			.enable-banner #top-row {
				height: calc(var(--banner-height-home) - 4.5rem);
				@apply transition-all duration-300;
			}
		}

		/* Water waves animation - GPU 加速优化 */
		.waves > .parallax use {
			animation: wave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
			transform: translateZ(0);
			will-change: transform;
			backface-visibility: hidden;
		}
		@keyframes wave {
			0% {
				transform: translate3d(-90px, 0, 0);
			}
			100% {
				transform: translate3d(85px, 0, 0);
			}
		}
	}
	@layer utilities {
		.typewriter {
			position: relative;
			min-height: 1.5em;
			display: inline-block;
			vertical-align: baseline;
		}

		.typewriter:empty::before {
			content: "\00A0";
			visibility: hidden;
		}

		@media (min-width: 1280px) {
			.enable-banner.lg\:is-home #sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
			.enable-banner.lg\:is-home #left-sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
			.enable-banner.lg\:is-home #right-sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
		}
		.navbar-hidden {
			@apply opacity-0 -translate-y-16;
		}
	}
</style>

<script>
	import { initBackToTopHandler } from "../scripts/handlers/back-to-top-handler";
	import { initFancybox } from "../scripts/handlers/fancybox-handler";
	import { initPanelHandler } from "../scripts/handlers/panel-handler";
	import { checkKatex, initCustomScrollbar } from "../scripts/handlers/scroll-handler";
	import "../scripts/paper-note-interactions";

	initBackToTopHandler(!!document.getElementById("banner-wrapper"));
	void initPanelHandler();
	void initFancybox();
	checkKatex();
	initCustomScrollbar();
</script>


<!-- 代码块折叠功能 -->
<script>
	import "../scripts/code-collapse.js";
</script>

<!-- 主题切换综合性能优化器（包含代码块优化、重型元素优化、性能诊断） -->
<script>
	import "../scripts/theme-optimizer.js";
</script>
