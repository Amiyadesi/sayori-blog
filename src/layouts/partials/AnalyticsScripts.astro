---
interface Props { count: boolean }
const { count } = Astro.props;
---

{count && <meta name="sayori-pageview" content="/api/analytics/pageview" />}

<script>
	let lastPath: string | undefined;

	function countPageview() {
		if (location.hostname !== "blog.sayori.org" || lastPath === location.pathname) return;
		lastPath = location.pathname;
		const endpoint = document.querySelector<HTMLMetaElement>('meta[name="sayori-pageview"]')?.content;
		if (!endpoint) return;
		fetch(endpoint, {
			method: "POST",
			credentials: "omit",
			referrerPolicy: "no-referrer",
			keepalive: true,
		}).catch(() => { /* A missed count must not interrupt reading. */ });
	}

	document.addEventListener("astro:page-load", countPageview);
	countPageview();
</script>
